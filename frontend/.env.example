# ==========================================================
# 모닝브리프 프론트엔드 환경 설정
# 복사해서 .env.local로 만들고 값을 채우세요
# ==========================================================

# Supabase (프로젝트 URL / anon public key)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 텔레그램 봇 username (t.me/<username> — @ 없이)
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# 디스코드 봇 초대(OAuth2) URL — 봇을 서버에 추가하는 링크
# 슬래시 커맨드 사용을 위해 applications.commands 스코프 필수
# https://discord.com/api/oauth2/authorize?client_id=<BOT_CLIENT_ID>&permissions=0&scope=bot%20applications.commands
NEXT_PUBLIC_DISCORD_BOT_INVITE_URL=

# Cloudflare Turnstile 사이트 키 (로봇 체크/CAPTCHA)
# 미설정 시 캡챠 UI가 자동으로 숨겨지고 토큰도 전송하지 않음
# https://dash.cloudflare.com → Turnstile → 사이트 추가 → Site key
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Naver 로그인 (Supabase 미지원 → 커스텀 OAuth 플로우)
# Naver Developers > 내 애플리케이션 > 네이버 로그인에서 확인/발급
# Callback URL: http://localhost:3000/auth/callback/naver (운영: https://<domain>/auth/callback/naver)
NEXT_PUBLIC_NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Supabase service_role 키 (서버 전용 — Naver 유저 생성용. 절대 브라우저에 노출 금지)
SUPABASE_SERVICE_ROLE_KEY=
