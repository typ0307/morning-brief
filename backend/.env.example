# ==========================================================
# 모닝브리프 백엔드 환경 설정 템플릿
# 복사해서 .env 파일로 만들고 값을 채우세요
# (.env는 절대 커밋 금지 - .gitignore에 포함됨)
# ==========================================================

# ---- Supabase (DB) ----
# 프로젝트 URL (대시보드 > Project Settings > API > Project URL)
SUPABASE_URL=
# service_role 키 (서버 전용, RLS 우회. 외부 노출 시 즉시 재발급)
SUPABASE_SERVICE_ROLE_KEY=

# ---- LLM: DeepSeek 단독 사용 ----
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# ---- Telegram 발송 ----
# BotFather에서 발급한 봇 토큰
TELEGRAM_BOT_TOKEN=
# 관리자 chat_id (선택) - 토픽 처리 실패 시 알림 수신
ADMIN_CHAT_ID=

# ---- 파이프라인 튜닝 ----
# 토픽당 최종 사용 기사 수 (LLM이 중복 제거 후 서로 다른 기사만 선별)
MAX_ARTICLES_PER_TOPIC=10
# LLM 선별 대상 후보 기사 수 (RSS 수집 후 최신순 상위 N건)
MAX_CANDIDATES_PER_TOPIC=20
# 요약 줄 수 (3줄 -> 5줄로 확장됨)
SUMMARY_LINES=5
# true: 키워드의 모든 단어가 기사 제목+스니펫에 포함된 기사만 통과
# (예: '에스파 카리나' -> '에스파'+'카리나' 둘 다 필요 -> '육상 카리나' 제외)
REQUIRE_ALL_KEYWORD_TOKENS=true
