# ==========================================================
# 모닝브리프 백엔드 환경 설정 템플릿
# 복사해서 .env 파일로 만들고 값을 채우세요
# (.env는 절대 커밋 금지 - .gitignore에 포함됨)
# ==========================================================

# ---- Supabase (DB) ----
# 프로젝트 URL (대시보드 > Project Settings > API > Project URL)
SUPABASE_URL=
# service_role 키 (서버 전용, RLS 우회. 외부 노출 시 즉시 재발급)
SUPABASE_SERVICE_ROLE_KEY=

# ---- LLM ----
# deepseek 또는 openrouter 선택
LLM_PROVIDER=deepseek

# DeepSeek (LLM_PROVIDER=deepseek 일 때 사용)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# OpenRouter (LLM_PROVIDER=openrouter 일 때 사용)
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=inclusionai/ling-3.0-flash
#   - Ling-3.0-flash: inclusionai/ling-3.0-flash
#   - Solar Pro 4: upstage/solar-pro4

# ---- Naver 뉴스 검색 API (기사 수집) ----
# 네이버 개발자센터에서 애플리케이션 등록 후 발급
# NAVER_CLIENT_ID=
# NAVER_CLIENT_SECRET=

# ---- Telegram 발송 ----
# BotFather에서 발급한 봇 토큰
TELEGRAM_BOT_TOKEN=
# 관리자 chat_id (선택) - 토픽 처리 실패 시 알림 수신
ADMIN_CHAT_ID=

# ---- 파이프라인 튜닝 ----
# 키워드별 요약에 사용할 기사 수 (LLM이 중복 제거 후 서로 다른 기사만 선별)
MAX_ARTICLES_PER_TOPIC=5
# LLM 선별 대상 후보 기사 수 (수집 후 최신순 상위 N건)
MAX_CANDIDATES_PER_TOPIC=20
# 수집 시 이 시간(단위:시간)보다 오래된 기사 제외 (0이면 비활성화)
MAX_ARTICLE_AGE_HOURS=48
# 요약 줄 수
SUMMARY_LINES=5
# true: 키워드의 모든 단어가 기사 제목+스니펫에 포함된 기사만 통과
# (예: '에스파 카리나' -> '에스파'+'카리나' 둘 다 필요 -> '육상 카리나' 제외)
REQUIRE_ALL_KEYWORD_TOKENS=true
